# PostgreSQL and Redis (Docker defaults)
POSTGRES_DB=ycgc
POSTGRES_USER=ycgc
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://ycgc:change_this_local_password@postgres:5432/ycgc
REDIS_URL=redis://redis:6379/0

# Backend
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# Phase 3 -- leave blank until Gemini integration is implemented
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Phase 1: anonymous Shorts feed settings (not keyword inputs)
YOUTUBE_REGION=US
YOUTUBE_LANGUAGE=en
YOUTUBE_PROFILES=ID:id,US:en,GB:en
YOUTUBE_SEED_MAX_AGE_HOURS=24
YOUTUBE_SESSIONS_PER_PROFILE=2
YOUTUBE_MAX_SESSIONS_PER_PROFILE=3
YOUTUBE_SEED_TARGET_CANDIDATES_PER_PROFILE=50
YOUTUBE_SEED_PAGES_PER_SESSION=20
YOUTUBE_SEED_LIMIT_PER_SESSION=100
YOUTUBE_SEED_INTERVAL_MINUTES=30
YOUTUBE_VELOCITY_INTERVAL_MINUTES=15
YOUTUBE_VELOCITY_MIN_OBSERVATION_MINUTES=30
YOUTUBE_FAST_POLL_MAX_AGE_HOURS=12
YOUTUBE_ULTRA_FRESH_MAX_AGE_HOURS=6
YOUTUBE_ULTRA_FRESH_POLL_MINUTES=15
YOUTUBE_FAST_POLL_MINUTES=30
YOUTUBE_MATURE_POLL_MINUTES=60
YOUTUBE_VELOCITY_LOCK_SECONDS=1500
YOUTUBE_BREAKOUT_MIN_VIEW_DELTA=1000
YOUTUBE_BREAKOUT_MIN_VELOCITY_PER_HOUR=1000
YOUTUBE_RELATIVE_SCORING_ENABLED=false
YOUTUBE_RELATIVE_MIN_SAMPLES=30
YOUTUBE_RELATIVE_EARLY_PERCENTILE=80
YOUTUBE_RELATIVE_RISING_PERCENTILE=92
YOUTUBE_RELATIVE_BREAKOUT_PERCENTILE=97

# Frontend (browser-facing backend origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010
